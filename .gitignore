class Calculator
{
    public double Sabirane(double a, double b)
    {
        return a + b;
    }
 
    public double Izvazhdane(double a, double b)
    {
        return a - b;
    }
public double Umnozhenie(double a, double b)
    {
        return a * b;
    }
 
    public double Delenie(double a, double b)
    {
        return a / b;
    }
}
